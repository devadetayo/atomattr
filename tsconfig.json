{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "paths": {
      "react": [
        "../../mobile-app/node_modules/@types/react"
      ],
      "react/*": [
        "../../mobile-app/node_modules/@types/react/*"
      ],
      "react-native": [
        "../../mobile-app/node_modules/react-native"
      ],
      "react-native/*": [
        "../../mobile-app/node_modules/react-native/*"
      ]
    }
  },
  "include": [
    "react/**/*.ts",
    "react/**/*.tsx",
    "react-native/**/*.ts",
    "react-native/**/*.tsx",
    "src/**/*.js",
    "types.d.ts"
  ]
}
